---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import JsonLd from "@components/base/JsonLd.astro";
import Page from "@layouts/Page.astro";
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);

const pubDateLabel = post.data.pubDate.toLocaleDateString("fi-FI", {
  year: "numeric",
  month: "numeric",
  day: "numeric",
});

// Build Article JSON-LD schema from frontmatter
const articleSchema: Record<string, unknown> = {
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  publisher: { "@type": "Organization", name: "Myrrys" },
};
if (post.data.heroImage) {
  articleSchema.image = new URL(post.data.heroImage.src, Astro.site).href;
}
if (post.data.author) {
  articleSchema.author = { "@type": "Person", name: post.data.author };
}
---

<Page
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage?.src}
>
  <JsonLd schema={articleSchema} />
  <main class:list={[post.data.theme, "content-grid"]}>
    <section>
      <article>
        {
          post.data.heroImage && (
            <Image
              src={post.data.heroImage}
              alt=""
              class="poster"
              widths={[400, 800, 1200]}
              sizes="(max-width: 640px) 100vw, 800px"
            />
          )
        }
        <h1>{post.data.title}</h1>
        <p class="byline text-small">
          <time datetime={post.data.pubDate.toISOString()}>{pubDateLabel}</time>
          {post.data.author && <span> – {post.data.author}</span>}
        </p>
        <Content />
      </article>
    </section>
  </main>
</Page>

<style>
  article :global(figure) {
    margin: calc(var(--grid) * 2) 0;
  }
  article :global(figure img) {
    width: 100%;
    height: auto;
  }
  article :global(figcaption) {
    font-size: calc(0.875 * var(--grid));
    line-height: calc(1.5 * var(--grid));
    opacity: 0.75;
    margin-top: calc(0.5 * var(--grid));
    text-align: center;
  }
  /* Markdown tables: no global table styling exists, so scope it to articles. */
  article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: calc(var(--grid) * 2) 0;
    display: block;
    overflow-x: auto;
  }
  /* Single :global() wrapping :is() — a comma-separated pair of :global()
     selectors compiles to invalid CSS in Astro's scoper. */
  article :global(:is(th, td)) {
    text-align: left;
    vertical-align: top;
    padding: calc(0.5 * var(--grid)) var(--grid);
    border-bottom: 1px solid
      color-mix(in hsl, transparent, var(--surface-secondary) 25%);
  }
  article :global(thead th) {
    border-bottom-width: 2px;
    border-bottom-color: var(--color-primary);
  }
  article :global(tbody tr:nth-child(odd)) {
    background: color-mix(in hsl, transparent, var(--color-primary) 10%);
  }
  .poster {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    object-position: center;
    border-radius: 8px;
    margin-bottom: calc(var(--grid) * 2);
  }
</style>
